# Nome do executável
TARGET = parsim

# Compilador
CC = gcc

# Flags de compilação
CFLAGS = -Wall -Wextra -O2 -std=c11

# Biblioteca matemática
LDFLAGS = -lm

# Arquivos-fonte
SRCS = particulas.c parsim.c

# Arquivos-objeto
OBJS = $(SRCS:.c=.o)

# Regra padrão: compilar o projeto
$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS) $(LDFLAGS)  # <- Moved -lm here

# Compilar arquivos individuais
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Limpar arquivos compilados
clean:
	rm -f $(OBJS) $(TARGET)
